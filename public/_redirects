# Cloudflare Pages serves index.html (200 text/html) for any unmatched route,
# including /assets/<old-hash>.js when a user's stale tab references a chunk
# from a previous deploy. That HTML response poisons the dynamic-import system
# and the browser throws "Failed to fetch dynamically imported module".
#
# Force a real 404 for missing hashed assets so the service worker + client
# code can detect "stale shell" and self-heal instead of caching HTML as JS.
/assets/*  /assets/__missing__  404
